# Copie para .env e ajuste. NUNCA coloque este arquivo no git.

# Onde o OpenJarvis está rodando (jarvis serve). No mesmo computador: 127.0.0.1.
OPENJARVIS_URL=http://127.0.0.1:8000
# Mesma chave configurada no OpenJarvis (jarvis auth create-key). Fica só aqui.
OPENJARVIS_API_KEY=
# Modelo a usar. Vazio = o modelo padrão informado pelo OpenJarvis em /v1/info.
OPENJARVIS_MODEL=

# Endereço do gateway. 0.0.0.0 = aceita conexões da rede Wi-Fi local.
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8787
# Pasta onde ficam os dispositivos pareados (tokens guardados só como hash).
GATEWAY_DATA_DIR=./data
# Limite de mensagens por minuto por celular.
GATEWAY_RATE_LIMIT_PER_MIN=30

# HTTPS direto no gateway (opcional). Para acesso pela internet, prefira um
# túnel/proxy com HTTPS (veja o README).
TLS_CERT_FILE=
TLS_KEY_FILE=
