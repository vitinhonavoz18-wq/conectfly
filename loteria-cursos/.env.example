# =============================================================================
# Loteria Cursos — Social Media Automation
# Copie para .env (o script scripts/setup.sh faz isso e gera as senhas sozinho).
# O .env NUNCA vai para o git. Segredos: só aqui e nas Credentials do n8n.
# =============================================================================

APP_ENV=development
TZ=America/Bahia
LOG_LEVEL=info

# ---------------------------------------------------------------- n8n
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
# URL pública do n8n (usada nos webhooks). Em produção: https://seu-dominio/
N8N_WEBHOOK_URL=http://localhost:5678/
# Chave que criptografa as credenciais no banco do n8n. GERE UMA VEZ e guarde (openssl rand -hex 32).
# Se perder, as credenciais salvas no n8n ficam ilegíveis.
N8N_ENCRYPTION_KEY=
# Em produção com HTTPS, use true.
N8N_SECURE_COOKIE=false
N8N_IMAGE=docker.n8n.io/n8nio/n8n:2.41.5
# Token do webhook de teste manual (header X-LC-Token). Gere com: openssl rand -hex 24
N8N_WEBHOOK_TOKEN=

# ---------------------------------------------------------------- PostgreSQL
# Banco local (docker). Para usar o Postgres do Supabase em produção, veja docs/SUPABASE_SETUP.md.
POSTGRES_USER=loteria
POSTGRES_PASSWORD=
POSTGRES_DB=loteria
POSTGRES_PORT=5432
N8N_DB_NAME=n8n
# URL do banco da APLICAÇÃO (scripts e testes fora do docker usam esta):
DATABASE_URL=postgres://loteria:TROQUE_A_SENHA@localhost:5432/loteria
# Onde o n8n (dentro do docker) acessa o banco da aplicação (credencial "Postgres — Loteria Cursos"):
APP_DB_HOST=postgres
APP_DB_PORT=5432
APP_DB_SSL=disable
# Só se o banco da aplicação ficar FORA do Docker (ex.: Supabase). Vazio = usa POSTGRES_*.
MIGRATE_DATABASE_URL=
APP_DB_NAME=
APP_DB_USER=
APP_DB_PASSWORD=

# ---------------------------------------------------------------- Supabase Storage
# local = arquivos no próprio renderer (só desenvolvimento; a Meta NÃO consegue baixar de localhost)
# supabase = produção (bucket PÚBLICO "social-media")
STORAGE_DRIVER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=social-media
RENDERER_PUBLIC_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------- OpenAI
OPENAI_API_KEY=
# Modelo para as legendas (confira os disponíveis em https://platform.openai.com/docs/models).
# Vazio = o sistema usa a legenda de reserva (nenhum post para por falta de IA).
OPENAI_MODEL=gpt-5.4-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------------- Meta / Instagram
# Instagram API com Login do Instagram → https://graph.instagram.com (recomendado, ver docs/META_SETUP.md)
# Instagram API com Login do Facebook  → https://graph.facebook.com
META_GRAPH_HOST=https://graph.instagram.com
# Versão da Graph API (configurável). Confira a atual em developers.facebook.com/docs/graph-api/changelog
META_GRAPH_API_VERSION=v26.0
META_ACCESS_TOKEN=
META_IG_USER_ID=
# SEGURANÇA: só publica de verdade com true. Com false, tudo roda e a Meta NÃO recebe media_publish.
ENABLE_REAL_INSTAGRAM_PUBLISH=false
MIN_SECONDS_BETWEEN_PUBLISHES=60

# ---------------------------------------------------------------- Serviços internos
ENGINE_URL=http://engine:3001
RENDERER_URL=http://renderer:3000
RENDERER_PORT=3000

# ---------------------------------------------------------------- Loterias
LOTTERY_SOURCE=caixa
# Vazio = endpoint padrão da CAIXA (ver docs/LOTTERY_SOURCE.md)
CAIXA_BASE_URL=
LOTTERY_RESULT_POLL_INTERVAL_SECONDS=180
LOTTERY_RESULT_MAX_ATTEMPTS=10

# ---------------------------------------------------------------- Marca e alertas
BRAND_NAME="LOTERIA CURSOS"
DEFAULT_CTA='Comente "EU QUERO" para continuar acompanhando nossos palpites e resultados.'
# Opcional: URL que recebe alertas de erro (POST JSON). Vazio = sem alerta externo.
ALERT_WEBHOOK_URL=

# ---------------------------------------------------------------- Testes
# Teste contra APIs reais: só roda com AS DUAS em true (proteção contra publicação acidental).
RUN_REAL_INTEGRATION_TESTS=false
