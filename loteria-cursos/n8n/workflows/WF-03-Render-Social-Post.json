    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "// Tentativa atual + pedido à OpenAI (modelo vem da configuração, não do código).\nconst j = $input.item.json;\nconst ctx = j.finalize?.context ?? {};\nconst c = $('DB — Load Post').first().json.ctx;\nreturn { json: { attempt: ctx.loop === 'caption' ? Number(ctx.attempt ?? 0) + 1 : 1, request: { ...c.caption_request, model: c.settings.openai_model } } };\n"
      },
