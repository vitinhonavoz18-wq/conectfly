# Variáveis do APP (usadas só na hora de compilar, não são secretas).
# Copie para .env se quiser usá-las localmente. Nunca coloque chaves de IA aqui:
# elas ficam apenas no gateway/OpenJarvis (veja gateway/.env.example).

# ID do projeto no expo.dev — preenchido depois de rodar "npx eas-cli init".
# (Alternativa: cole o id direto em app.config.ts, na constante EAS_PROJECT_ID.)
EAS_PROJECT_ID=
# Seu usuário ou organização no expo.dev (opcional).
EXPO_OWNER=

# Não use EXPO_PUBLIC_* para segredos: tudo com esse prefixo vai para dentro do APK.
