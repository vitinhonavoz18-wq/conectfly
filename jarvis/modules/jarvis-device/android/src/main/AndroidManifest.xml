<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!--
    O serviço de acessibilidade fica declarado no próprio módulo: o Android junta
    este manifesto ao do app em toda compilação, então ele sobrevive ao
    "expo prebuild" sem edição manual da pasta android/.
    exported=true é exigido para o sistema se ligar ao serviço; a permissão
    BIND_ACCESSIBILITY_SERVICE garante que só o sistema Android pode fazê-lo.
  -->
  <!-- Serviços em primeiro plano (Android 14+ exige o tipo declarado). -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <application>
    <!-- Escuta da palavra "Jarvis" (microfone, só com notificação fixa). -->
    <service
      android:name="expo.modules.jarvisdevice.JarvisWakeService"
      android:exported="false"
      android:foregroundServiceType="microphone" />
    <!-- "Assistir junto": captura de tela, só depois do aviso do Android. -->
    <service
      android:name="expo.modules.jarvisdevice.JarvisScreenService"
      android:exported="false"
      android:foregroundServiceType="mediaProjection" />

    <service
      android:name="expo.modules.jarvisdevice.JarvisAccessibilityService"
      android:exported="true"
      android:label="@string/jarvis_accessibility_label"
      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data
        android:name="android.accessibilityservice"
        android:resource="@xml/jarvis_accessibility_config" />
    </service>
  </application>
</manifest>
