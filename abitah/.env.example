# ===========================================================================
# ABITAH — Variáveis de ambiente
# Copie este arquivo para .env.local e preencha com os seus valores.
# NUNCA versione o .env.local nem cole chaves privadas no código.
# ===========================================================================

# --- Site ------------------------------------------------------------------
# URL pública (usada em SEO, sitemap e nos links enviados pelo WhatsApp).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- WhatsApp e contato ----------------------------------------------------
# Formato internacional, apenas dígitos: 55 + DDD + número.
NEXT_PUBLIC_WHATSAPP_NUMBER=5511999999999
NEXT_PUBLIC_CONTACT_EMAIL=contato@abitah.com.br

# --- Supabase --------------------------------------------------------------
# Encontre em: Supabase → Project Settings → API
# Sem estas variáveis o site roda em MODO DEMONSTRAÇÃO (catálogo local).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de serviço — SOMENTE no servidor, nunca com prefixo NEXT_PUBLIC_.
# Opcional: usada apenas por rotinas administrativas que ignoram RLS.
SUPABASE_SERVICE_ROLE_KEY=
