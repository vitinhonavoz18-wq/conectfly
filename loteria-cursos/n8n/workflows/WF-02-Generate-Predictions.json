    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const i = $input.item.json;\nif (!/^[a-z0-9_]+$/.test(String(i.game ?? ''))) throw new Error('INVALID_PREDICTION_INPUT: game inválido');\nconst contest = i.contest === undefined || i.contest === null ? null : Number(i.contest);\nif (contest !== null && (!Number.isInteger(contest) || contest < 1)) throw new Error('INVALID_PREDICTION_INPUT: contest inválido');\nreturn { json: { game: i.game, contest, dry_run: i.dry_run === true, correlation_id: String(i.correlation_id ?? $execution.id) } };\n"
      },
      "id": "7ce92e73-7608-40a0-ac4d-f61f4f643ef9",
      "name": "Validate — Prediction Input",
