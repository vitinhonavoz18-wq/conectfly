        "options": {
          "queryReplacement": "={{ [ JSON.stringify({ post_id: $('Validate — Render Input').first().json.post_id, operation: 'caption', attempt: ($json.body?.outcome ? $json.body : { outcome: 'engine_error', reason: String($json.error?.message ?? ('engine HTTP ' + ($json.statusCode ?? 0))), attempt: 1, context: {} }).attempt ?? 1,\n        outcome: ['ok', 'fallback', 'retry'].includes(($json.body?.outcome ? $json.body : { outcome: 'engine_error', reason: String($json.error?.message ?? ('engine HTTP ' + ($json.statusCode ?? 0))), attempt: 1, context: {} }).outcome) ? ($json.body?.outcome ? $json.body : { outcome: 'engine_error', reason: String($json.error?.message ?? ('engine HTTP ' + ($json.statusCode ?? 0))), attempt: 1, context: {} }).outcome : 'fail',\n        error_code: ($json.body?.outcome ? $json.body : { outcome: 'engine_error', reason: String($json.error?.message ?? ('engine HTTP ' + ($json.statusCode ?? 0))), attempt: 1, context: {} }).outcome === 'ok' ? null : ({ fallback: 'CAPTION_FALLBACK', retry: 'CAPTION_RETRY' }[($json.body?.outcome ? $json.body : { outcome: 'engine_error', reason: String($json.error?.message ?? ('engine HTTP ' + ($json.statusCode ?? 0))), attempt: 1, context: {} }).outcome] ?? 'ENGINE_UNAVAILABLE'),\n        error_message: ($json.body?.outcome ? $json.body : { outcome: 'engine_error', reason: String($json.error?.message ?? ('engine HTTP ' + ($json.statusCode ?? 0))), attempt: 1, context: {} }).reason ?? null, correlation_id: $('Validate — Render Input').first().json.correlation_id }), JSON.stringify(($json.body?.outcome ? $json.body : { outcome: 'engine_error', reason: String($json.error?.message ?? ('engine HTTP ' + ($json.statusCode ?? 0))), attempt: 1, context: {} })) ] }}"
        }
      },
