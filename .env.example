# SiteCreatorFly — variáveis de ambiente
#
# Copie para `.env` e preencha com os valores reais.
# O `.env` é ignorado pelo git: NUNCA versione segredos.
#
# Em produção, estes valores vêm dos secrets do GitHub Actions (build) e
# dos secrets do Cloudflare Workers (runtime) — veja .github/workflows/deploy.yml.

# --- Cliente (embutidos no bundle pelo Vite — visíveis no browser) ---
VITE_SUPABASE_URL="https://<project-id>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY=""

# --- Servidor (SSR / rotas de API — nunca chegam ao browser) ---
SUPABASE_URL="https://<project-id>.supabase.co"
SUPABASE_PUBLISHABLE_KEY=""

# Service role: ignora RLS. Só no servidor, só via secret do Cloudflare.
SUPABASE_SERVICE_ROLE_KEY=""

# Segredo compartilhado com o FlyControl para /api/internal/provision-restaurant.
# Deve bater com SITECREATORFLY_INTERNAL_TOKEN no FlyControl.
FL_PROVISION_SECRET=""

# Assinatura HMAC dos webhooks vindos do FlyControl (/api/public/flycontrol-table-closed).
# Deve ser o MESMO valor do FL_WEBHOOK_SECRET no flycontrol-dash.
FL_WEBHOOK_SECRET=""

# Exigida por padrão (o FlyControl já assina toda chamada). Só defina como
# "false" como válvula de emergência, se a assinatura parar de bater em
# produção por algum motivo inesperado — nesse caso volta a só logar.
FL_WEBHOOK_REQUIRE_SIGNATURE="true"

# --- Tooling (Supabase CLI / supabase/config.toml) ---
# Não são lidos pelo código da aplicação.
SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PROJECT_ID=""
